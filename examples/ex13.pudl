# Short-circuit evaluation: `&&`/`||` must not evaluate their right-hand
# side when the left-hand side already determines the result.
# sideEffect() has an observable side effect (print) -- it must never be
# called here, since `False && ...` can never be true regardless of its
# right-hand side. Correct output is just "0".
func sideEffect( int x ) : bool {
  print 999
  return True
}

func mast : int {
  bool result = False && sideEffect(0)
  print result
  return 0
}
